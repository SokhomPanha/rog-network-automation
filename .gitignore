# Local credentials, archives and device output.
/backups/**
/evidence/**
/archive/legacy/**
!/archive/legacy/README.md
/reports/**

# Vault and credential files (encrypted local copies only).
/inventory/group_vars/*/vault.yml
/inventory/vault.yml
*vault*.yml
*vault*.yaml
*vault-password*
*vault_password*
.vault_pass*
.vault-pass*
*credentials*
*credential*
*.env
.env.*

# Private keys and certificates.
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*

# Device configuration and operational exports.
*.backup
*.rsc
*.cfg
!ansible.cfg
*.conf
*.log
*.retry
*.zip
*.tar.gz
*.bak
*.tmp
*.before-*

# Token/password-containing local files.
*.secret
*.secrets
*.token
*.tokens

# Python and automation cache state.
__pycache__/
.vscode/
.venv/
.pytest_cache/
.ansible/

!devices/**/templates/*.j2
